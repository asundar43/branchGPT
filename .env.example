# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Authentication
# Generate a random string for AUTH_SECRET (used for session encryption)
AUTH_SECRET=your_auth_secret

# Vercel Blob Storage
# Get your token from Vercel dashboard under Storage
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# Database Configuration
# Neon Database (PostgreSQL) connection details
POSTGRES_HOST=your_postgres_host
POSTGRES_URL_NO_SSL=your_postgres_url_no_ssl
PGUSER=your_pguser
PGHOST_UNPOOLED=your_pghost_unpooled
PGDATABASE=your_pgdatabase
PGPASSWORD=your_pgpassword
POSTGRES_DATABASE=your_postgres_database
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=your_database_url
POSTGRES_USER=your_postgres_user
PGHOST=your_pghost
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling
DATABASE_URL_UNPOOLED=your_database_url_unpooled
POSTGRES_PRISMA_URL=your_postgres_prisma_url
POSTGRES_URL=your_postgres_url

# Stripe Configuration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Application URL
# Your production or development URL
NEXT_PUBLIC_APP_URL=your_app_url

# Stripe Webhook Secret
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs
# Get these from Stripe Dashboard > Products
STRIPE_MONTHLY_PRICE_ID=your_stripe_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=your_stripe_annual_price_id

# Public Stripe Price IDs (used in frontend)
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=your_stripe_monthly_price_id
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=your_stripe_annual_price_id

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Perplexity AI API
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key

# XAI API Configuration
# Get your API key from XAI dashboard
XAI_API_KEY=your_xai_api_key

# Resend Email Service
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Cron Job Secret
# Used for securing cron job endpoints
CRON_SECRET=your_cron_secret 